{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "clean:dev": "node -e \"const fs=require('fs');const paths=['.angular/cache','node_modules/.vite'];for(const p of paths){try{fs.rmSync(p,{recursive:true,force:true});console.log('removed',p)}catch(e){console.warn('skip',p,e.message)}}\"",
    "recover:dev": "npm run clean:dev && npm install && npm start"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/elements": "^21.2.10",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lucide/angular": "^1.9.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@panzoom/panzoom": "^4.6.2",
    "@tailwindcss/postcss": "^4.2.4",
    "apexcharts": "^5.10.6",
    "elkjs": "^0.8.2",
    "flowbite": "^4.0.1",
    "ng-apexcharts": "^2.4.0",
    "notyf": "^3.10.0",
    "ol": "^10.9.0",
    "rete": "^2.0.6",
    "rete-angular-plugin": "^2.6.0",
    "rete-area-plugin": "^2.1.5",
    "rete-auto-arrange-plugin": "^2.0.2",
    "rete-connection-plugin": "^2.0.5",
    "rete-render-utils": "^2.0.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.59.1",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "web-worker": "^1.5.0"
  }
}
